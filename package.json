{
  "name": "nuxt-files-sdk-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun --filter nuxt-files-sdk build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "deps:update": "taze",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "bun --filter nuxt-files-sdk test",
    "typecheck": "bun --filter nuxt-files-sdk typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "taze": "^21.1.0"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "bun@1.4.0"
}
