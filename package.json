{
    "name": "nuxt-files-sdk-workspace",
    "private": true,
    "workspaces": [
        "packages/*",
        "docs"
    ],
    "type": "module",
    "scripts": {
        "build": "vp -C packages/nuxt-files-sdk pack",
        "check": "bun run format:check && bun run lint && bun run workspace:check && bun run unused && bun run typecheck && bun run test && bun run docs:build",
        "deps:update": "taze",
        "peers:sync": "bun scripts/sync-optional-peers.ts",
        "dev": "bun run build && bun --cwd=docs dev",
        "dev:devtools-v4": "bun run build && bun --cwd=test/fixtures/nuxt5-nightly install --ignore-scripts && bun --cwd=test/fixtures/nuxt5-nightly run dev",
        "docs:build": "bun run build && bun run --cwd=docs build && bun scripts/verify-docs-output.ts",
        "docs:deploy": "bun run docs:build && bun run --cwd=docs deploy",
        "docs:preview": "bun run docs:build && bun run --cwd=docs preview",
        "docs:typecheck": "bun run build && bun run --cwd=docs typecheck",
        "format": "vp fmt . --write",
        "format:check": "vp fmt . --check",
        "lint": "bun run docs:prepare && vp lint .",
        "lint:fix": "bun run docs:prepare && vp lint . --fix",
        "preview:package": "pkg-pr-new publish ./packages/nuxt-files-sdk --bun --compact --previewVersion",
        "test": "vp test run",
        "test:unit": "vp test run --project unit",
        "typecheck": "bun --filter nuxt-files-sdk typecheck && bun run docs:typecheck && tsc --noEmit -p test/tsconfig.json",
        "unused": "bun run docs:prepare && knip && knip --production",
        "workspace:check": "sherif",
        "test:nuxt4": "vp test run --project nuxt4",
        "test:nuxt5": "vp test run --project nuxt5",
        "test:nitro2": "vp test run --project nitro-v2",
        "test:nitro3": "vp test run --project nitro-v3",
        "test:consumer": "vp test run --project consumer",
        "test:size": "vp test run --project bundle",
        "benchmark": "bun test/benchmark.ts",
        "benchmark:integration": "bun test/benchmark-integration.ts",
        "docs:prepare": "bun run build && bun run --cwd=docs prepare:types",
        "test:vite-server": "vp test run --project vite-server"
    },
    "devDependencies": {
        "@nuxt/schema": "^4.6.0",
        "@nuxt/test-utils": "^4.3.3",
        "files-sdk": "2.6.2",
        "knip": "^6.39.0",
        "npm": "11.21.0",
        "pkg-pr-new": "^0.0.90",
        "sherif": "^1.13.0",
        "taze": "^21.3.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
        "vite-plus": "1.0.0",
        "vitest": "5.0.1",
        "vscode-jsonrpc": "^9.0.3",
        "yaml": "^2.9.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
        "vitest": "5.0.1"
    },
    "engines": {
        "node": "^24.11.0 || >=26.0.0"
    },
    "packageManager": "bun@1.4.2"
}
