{
    "name": "nuxt-files-sdk-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "bun --filter nuxt-files-sdk build",
        "check": "bun run format:check && bun run lint && bun run workspace:check && bun run unused && bun run typecheck && bun run test && bun run build",
        "deps:update": "taze",
        "format": "oxfmt . --write",
        "format:check": "oxfmt . --check",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "preview:package": "pkg-pr-new publish ./packages/nuxt-files-sdk --bun --compact --previewVersion",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "typecheck": "bun --filter nuxt-files-sdk typecheck && tsc --noEmit -p test/tsconfig.json",
        "unused": "knip && knip --production",
        "workspace:check": "sherif",
        "test:nuxt4": "vitest run --project nuxt4",
        "test:nuxt5": "vitest run --project nuxt5",
        "test:nitro2": "vitest run --project nitro-v2",
        "test:nitro3": "vitest run --project nitro-v3",
        "test:consumer": "vitest run --project consumer",
        "test:size": "vitest run --project bundle",
        "benchmark": "bun packages/nuxt-files-sdk/test/benchmark.ts"
    },
    "devDependencies": {
        "@nuxt/schema": "^4.5.2",
        "@nuxt/test-utils": "^4.3.2",
        "files-sdk": "^2.4.1",
        "knip": "^6.35.1",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "oxlint-tsgolint": "^7.0.2001",
        "pkg-pr-new": "^0.0.88",
        "sherif": "^1.13.0",
        "taze": "^21.1.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "bun@1.4.2"
}
