{
    "name": "nuxt-files-sdk-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "bun --filter nuxt-files-sdk build",
        "check": "bun run format:check && bun run lint && bun run workspace:check && bun run unused && bun run typecheck && bun run test && bun run build",
        "deps:update": "taze",
        "format": "oxfmt . --write",
        "format:check": "oxfmt . --check",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "preview:package": "pkg-pr-new publish ./packages/nuxt-files-sdk --bun --compact --previewVersion",
        "test": "bun --filter nuxt-files-sdk test",
        "typecheck": "bun --filter nuxt-files-sdk typecheck",
        "unused": "knip && knip --production",
        "workspace:check": "sherif",
        "test:nuxt4": "bun run test:fixture nuxt4",
        "test:nuxt5": "bun run test:fixture nuxt5-nightly",
        "test:nitro2": "bun run test:fixture nitro-v2",
        "test:nitro3": "bun run test:fixture nitro-v3",
        "test:fixture": "bash test/scripts/fixture.sh",
        "test:consumer": "bash test/scripts/packed-consumer.sh",
        "test:size": "bash test/scripts/bundle-contract.sh",
        "benchmark": "bun packages/nuxt-files-sdk/test/benchmark.ts"
    },
    "devDependencies": {
        "knip": "^6.34.0",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "oxlint-tsgolint": "^7.0.2001",
        "pkg-pr-new": "^0.0.88",
        "sherif": "^1.13.0",
        "taze": "^21.1.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "bun@1.4.0"
}
