{
    "name": "nuxt-files-sdk",
    "version": "0.1.0",
    "description": "Native-first Files SDK integration for Nuxt and Nitro",
    "homepage": "https://github.com/liria24/nuxt-files-sdk#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liria24/nuxt-files-sdk.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/module.js",
    "types": "./dist/module.d.ts",
    "exports": {
        ".": {
            "types": "./dist/module.d.ts",
            "import": "./dist/module.js",
            "default": "./dist/module.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "import": "./dist/config.js",
            "default": "./dist/config.js"
        },
        "./nitro": {
            "types": "./dist/nitro.d.ts",
            "import": "./dist/nitro.js",
            "default": "./dist/nitro.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": "./dist/runtime.js",
            "default": "./dist/runtime.js"
        },
        "./ui/locale": {
            "types": "./dist/ui/locale.d.ts",
            "import": "./dist/ui/locale.js",
            "default": "./dist/ui/locale.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsdown && vite build --config devtools.vite.config.ts",
        "dev": "tsdown --watch",
        "prepack": "bun run build",
        "typecheck": "node typecheck.cjs --noEmit"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.1",
        "@nuxt/devtools-kit": "4.0.0-beta.1",
        "@nuxt/icon": "^2.5.1",
        "@nuxt/kit": "^4.5.2",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "devframe": "^1.0.0",
        "files-sdk": "^2.6.0",
        "jiti": "^2.7.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@iconify-json/lucide": "^1.2.135",
        "@nuxt/schema": "^4.5.2",
        "@types/node": "^26.6.2",
        "@vitejs/devtools-kit": "^0.7.5",
        "@vitejs/plugin-vue": "^6.0.8",
        "publint": "^0.3.24",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2",
        "typescriptVue": "npm:typescript@6.0.3",
        "vite": "^8.3.0",
        "vue": "^3.5.43",
        "vue-tsc": "^3.3.11"
    },
    "peerDependencies": {
        "@nuxt/ui": "^4.11.1",
        "nuxt": "^4.0.0 || ^5.0.0"
    },
    "peerDependenciesMeta": {
        "@nuxt/ui": {
            "optional": true
        },
        "nuxt": {
            "optional": true
        }
    }
}
