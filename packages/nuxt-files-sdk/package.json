{
    "name": "nuxt-files-sdk",
    "version": "0.0.0",
    "description": "Native-first Files SDK integration for Nuxt and Nitro",
    "homepage": "https://github.com/liria24/nuxt-files-sdk#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liria24/nuxt-files-sdk.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/module.js",
    "types": "./dist/module.d.ts",
    "exports": {
        ".": {
            "types": "./dist/module.d.ts",
            "import": "./dist/module.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "import": "./dist/config.js"
        },
        "./nitro": {
            "types": "./dist/nitro.d.ts",
            "import": "./dist/nitro.js"
        },
        "./plugins": {
            "types": "./dist/plugins.d.ts",
            "import": "./dist/plugins.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": "./dist/runtime.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@nuxt/kit": "^4.5.2",
        "devframe": "^0.9.12",
        "files-sdk": "^2.3.1"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@nuxt/schema": "^4.5.2",
        "@types/node": "^26.4.1",
        "publint": "^0.3.24",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2",
        "vue": "^3.5.42"
    },
    "peerDependencies": {
        "nuxt": "^4.0.0 || ^5.0.0"
    },
    "peerDependenciesMeta": {
        "nuxt": {
            "optional": true
        }
    }
}
