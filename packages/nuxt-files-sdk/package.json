{
    "name": "nuxt-files-sdk",
    "version": "0.1.1",
    "description": "Files SDK integration for Nuxt with DevTools",
    "homepage": "https://nuxt-files-sdk.liria.me",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liria24/nuxt-files-sdk.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/module.js",
    "types": "./dist/module.d.ts",
    "exports": {
        ".": {
            "types": "./dist/module.d.ts",
            "import": "./dist/module.js",
            "default": "./dist/module.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "import": "./dist/config.js",
            "default": "./dist/config.js"
        },
        "./nitro": {
            "types": "./dist/nitro.d.ts",
            "import": "./dist/nitro.js",
            "default": "./dist/nitro.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": "./dist/runtime.js",
            "default": "./dist/runtime.js"
        },
        "./package.json": "./package.json",
        "./module.json": "./dist/module.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "prepack": "bun ../../scripts/sync-optional-peers.ts --check && bun run build",
        "typecheck": "tsc --noEmit"
    },
