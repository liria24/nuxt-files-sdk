{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "workspaces": {
        ".": {
            "entry": ["*.config.ts"],
            "project": ["*.config.ts"]
        },
        "packages/nuxt-files-sdk": {
            "entry": [
                "tsdown.config.ts",
                "src/{module,config,nitro,plugins}.ts",
                "test/**/*.test.ts",
                "test/benchmark.ts"
            ],
            "ignoreDependencies": ["@arethetypeswrong/cli", "nitropack"],
            "ignoreIssues": {
                "package.json": ["optionalPeerDependencies"]
            },
            "project": ["src/**/*.ts!", "test/**/*.ts", "*.config.ts"]
        }
    }
}
