{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "ignore": ["test/fixtures/**"],
    "workspaces": {
        ".": {
            "entry": ["*.config.ts", "test/**/*.test.ts"],
            "project": ["*.ts", "test/**/*.ts"]
        },
        "packages/nuxt-files-sdk": {
            "entry": [
                "src/{module,config,nitro,runtime}.ts!",
                "src/integration/nitro-event.ts!",
                "src/runtime/{internal,development,gateway-secret}.ts!",
                "src/config/merge.ts!",
                "src/devtools/{files-read,files-write,nuxt-v3-handler,snapshot,token,client/app}.ts!"
            ],
            "ignoreDependencies": ["@arethetypeswrong/cli", "@vitejs/devtools-kit", "publint"],
            "ignoreIssues": {
                "package.json": ["optionalPeerDependencies"]
            },
            "project": ["src/**/*.{ts,vue}!", "*.config.ts"]
        },
        "docs": {
            "entry": [
                "files.config.ts!",
                "app/{app,error}.vue!",
                "app/pages/**/*.vue!",
                "app/layouts/**/*.vue!",
                "server/{api,routes,plugins,middleware}/**/*.ts!",
                "server/error.ts!"
            ],
            "ignoreDependencies": ["@iconify-json/lucide", "@iconify-json/simple-icons", "nuxtseo-layer-devtools"],
            "project": ["app/**/*.{ts,vue,css}!", "server/**/*.ts!", "shared/**/*.ts!", "*.ts"]
        }
    }
}
