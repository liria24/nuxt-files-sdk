{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "ignore": ["test/fixtures/**"],
    "workspaces": {
        ".": {
            "entry": ["*.config.ts", "test/**/*.test.ts"],
            "project": ["*.{ts,vue}", "test/**/*.ts"]
        },
        "packages/nuxt-files-sdk": {
            "entry": [
                "src/{module,config,nitro,runtime}.ts",
                "src/ui/components/*.vue",
                "src/ui/controls/**/*.vue",
                "src/ui/integration/UTheme.vue"
            ],
            "ignoreDependencies": [
                "@arethetypeswrong/cli",
                "@iconify-json/lucide",
                "@tailwindcss/postcss",
                "@vitejs/devtools-kit",
                "reka-ui"
            ],
            "ignoreIssues": {
                "package.json": ["optionalPeerDependencies"]
            },
            "project": ["src/**/*.{ts,vue}!", "*.config.ts"]
        },
        "docs": {
            "entry": ["files.config.ts!", "app/**/*.{ts,vue}!", "server/**/*.ts!"],
            "ignoreDependencies": [
                "@iconify-json/lucide",
                "@iconify-json/simple-icons",
                "@vueuse/core",
                "nuxtseo-layer-devtools"
            ],
            "project": ["**/*.{ts,vue,css}"]
        }
    }
}
